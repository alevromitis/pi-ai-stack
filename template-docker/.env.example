# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.
#
# Compose auto-loads a file named exactly `.env`, and ONLY that file feeds
# ${...} interpolation in ports:/volumes:. env_file: entries set container
# environment and are never interpolated - so anything you reference as
# ${VAR} in a compose file has to be here, not in .env.app.

# --- Host paths ---
# Host data root. Compose interpolates ${...} inside .env itself, so every
# per-service dir below is derived from it. On rpi this is
# /home/<user>/docker/prod. Rename APP_ to <SERVICE>_ and app/ to
# <service>/ when you copy the template.
DATA_ROOT=/home/<user>/docker/prod
APP_DATA_DIR=${DATA_ROOT}/app/data
# Tailscale node state (tailscale variant only). Losing it re-registers the
# node, so keep it on the host, not in a named volume.
APP_TAILSCALE_STATE_DIR=${DATA_ROOT}/app/data-tailscale

# --- App ---
# Host port the app is published on (app-only variant).
APP_PORT=3000
# Port the app actually listens on INSIDE its container. Caddy proxies here,
# and this is the container side of the APP_PORT mapping. Keep them distinct:
# APP_PORT is "where you reach it from the host", APP_CONTAINER_PORT is
# "where the process binds". They are only equal by coincidence.
APP_CONTAINER_PORT=3000

# Port Caddy listens on inside its container. Tailscale Serve proxies to it -
# keep tailscale-config/serve-config.json in sync.
CADDY_PORT=8080

# --- Image tags ---
# One tag per image. Pin each to an immutable version or digest before
# deploying; `latest` is a floating tag you cannot roll back from.
TAG=latest
TAILSCALE_TAG=latest
CADDY_TAG=2

TZ=UTC
