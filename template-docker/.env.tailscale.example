# Copy this file to .env.tailscale and fill in real values.
# NEVER commit the actual .env.tailscale file.

# --- Tailscale ---
# Node name on the tailnet.
TS_HOSTNAME=app
TS_CERT_DOMAIN=app.example.ts.net
# Tagged auth key from the tailnet admin console. Never commit a real one.
TS_AUTHKEY=
TS_EXTRA_ARGS=--advertise-tags=tag:container
TS_STATE_DIR=/var/lib/tailscale
TS_SERVE_CONFIG=/config/serve-config.json
TS_USERSPACE=false