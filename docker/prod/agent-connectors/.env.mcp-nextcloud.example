# Copy this file to .env.mcp-nextcloud and fill in real values.
# NEVER commit the actual .env.mcp-nextcloud file.
#
# --- Nextcloud ---
# The instance's domain (AIO's NC_DOMAIN). Sent as the Host header: AIO's
# internal Caddy routes on it and Nextcloud checks it against trusted_domains.
NEXTCLOUD_HOST=nextcloud.<tailnet>.ts.net
# The user, and an app password for this connector only: Personal settings >
# Security > Devices & sessions > Create new app password. Revoke it there.
NEXTCLOUD_USER=
NEXTCLOUD_APP_PASSWORD=
#
# --- Where new items go (display names; empty = Nextcloud's "Personal") ---
NEXTCLOUD_DEFAULT_CALENDAR=
NEXTCLOUD_DEFAULT_TASK_LIST=
#
# --- House style for new events (copied from the user's own calendar) ---
# Reminder before each new event, as an iCalendar duration; empty = none.
NEXTCLOUD_EVENT_ALARM=-PT10M
#
# --- Tool gating ---
# true: listing and reading only, on all three endpoints.
READ_ONLY=false
# true: also offer event_delete, task_delete and note_delete. Off by default:
# feed items and web pages can carry injected instructions. Deletions land in
# Nextcloud's trash bins either way.
ALLOW_DELETE=false
#
# --- Output size ---
# Cap on one note_read, in characters.
NEXTCLOUD_NOTE_MAX_CHARS=8000
