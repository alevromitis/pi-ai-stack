# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.
#
# Auto-loaded by Compose for ${...} interpolation only. Nothing here is
# secret: the credentials live in .env.mcp-freshrss / .env.mcp-nextcloud.
# This stack keeps no data, so there is no DATA_ROOT.

# Local time zone: how the model's "tomorrow 15:00" is read and how times
# are shown back.
TZ=Etc/UTC

# --- Networks ---
# The bridge network the freshrss stack creates; mcp-freshrss joins it.
FRESHRSS_NETWORK=freshrss-external
# Nextcloud AIO's network (made by its mastercontainer); mcp-nextcloud joins it.
NEXTCLOUD_NETWORK=nextcloud-aio
