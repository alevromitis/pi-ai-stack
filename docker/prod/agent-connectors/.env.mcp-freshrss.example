# Copy this file to .env.mcp-freshrss and fill in real values.
# NEVER commit the actual .env.mcp-freshrss file.
#
# --- FreshRSS (Google Reader API) ---
# The FreshRSS user, and its API password: Settings > Profile > API
# management in FreshRSS. That is separate from the login password and only
# opens the API; change it there to revoke this connector.
FRESHRSS_USER=
FRESHRSS_API_PASSWORD=
#
# --- Tool gating ---
# true: only rss_feeds, rss_items and rss_read (no marking, no subscribing).
READ_ONLY=false
#
# --- Output size (characters; each one is prefilled on the Pi's CPU) ---
# Summary snippet under each listed item; 0 lists titles only.
FRESHRSS_SNIPPET_CHARS=200
# Cap on one rss_read article.
FRESHRSS_READ_MAX_CHARS=6000
#
# --- Title-only feeds ---
# true: when an item has (almost) no text in the feed, rss_read fetches its
# page and up to FRESHRSS_MAX_PDFS linked PDFs (first FRESHRSS_PDF_PAGES
# pages each). Public addresses only; PDFs only from the page's own site.
FRESHRSS_FETCH_PAGES=true
FRESHRSS_MAX_PDFS=2
FRESHRSS_PDF_PAGES=4
