# Copy this file to .env.mcp-mail and fill in real values.
# NEVER commit the actual .env.mcp-mail file.
#
# --- The mailbox (IMAP over TLS) ---
# NTUA: mail.ntua.gr answers on 993 from outside the VPN.
MAIL_IMAP_HOST=mail.ntua.gr
MAIL_IMAP_PORT=993
# The login name and its password. A rejected login is never retried: the
# connector refuses every call until this is fixed and it restarts, so it
# can't lock the account.
MAIL_USER=
MAIL_PASSWORD=
# The From address written into drafts (the login name if empty).
MAIL_ADDRESS=
#
# --- TLS ---
# NTUA's Cyrus offers only DHE with a 1024-bit key, below OpenSSL 3's
# default security level. Elsewhere use DEFAULT.
MAIL_TLS_CIPHERS=DEFAULT@SECLEVEL=1
#
# --- Drafts ---
# The folder drafts are saved to; "auto" finds \Drafts or one named Drafts.
MAIL_DRAFTS_FOLDER=auto
#
# --- Output size (characters) ---
MAIL_LIST_LIMIT=30
MAIL_READ_MAX_CHARS=8000
