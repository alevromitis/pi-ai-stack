# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.
#
# Auto-loaded by Compose for ${...} interpolation only. Nothing here is
# secret: this stack holds no credentials. Its privilege is the Docker
# socket (README "agent-sandbox"). It keeps no data, so there is no
# DATA_ROOT: every sandbox is thrown away.

# --- Per-sandbox limits (one sandbox per chat) ---
# SANDBOX_MEMORY of RAM, the rest of SANDBOX_MEMORY_SWAP (RAM + swap,
# Docker's --memory-swap) paged out to rpi's /var/swap. /dev/shm counts
# too. 1g: javac, kotlinc, rustc and ghc crawled in 256m (a JVM sizes its
# heap from it); a sandbox rarely holds it for long, and LiteRT-LM keeps
# ~3.3g. Past the total, an OOM kills the biggest process; `run` reports
# exit 137 as "most likely memory".
SANDBOX_MEMORY=1g
SANDBOX_MEMORY_SWAP=3g
# CPU time cap, in cores (the Pi 5 has 4; on 1, compiles crawled).
SANDBOX_CPUS=2
# Weight under contention, Docker default 1024: LiteRT-LM (and the rest of
# the host) win when the sandbox and the model both want the CPU.
SANDBOX_CPU_SHARES=256
SANDBOX_PIDS=1024
# Writable layer (apt installs, pip, files). Docker can't cap it on ext4,
# so the gateway measures it every 30 s and removes a sandbox past it.
SANDBOX_DISK_LIMIT=8g
# Optional write throttle that bounds how far past the limit 30 s can go:
# the block device backing /var/lib/docker (`df /var/lib/docker`, then its
# disk, e.g. /dev/nvme0n1 or /dev/mmcblk0). Empty = no throttle.
SANDBOX_DISK_DEVICE=
SANDBOX_DISK_WRITE_BPS=50m

# --- Lifecycle ---
# Concurrent sandboxes (3: a second chat or a parallel test run doesn't
# evict the first). A new chat over the limit evicts the one used least
# recently; its chat gets a fresh sandbox (and is told so) if it comes back.
SANDBOX_MAX_ACTIVE=3
SANDBOX_IDLE_MINUTES=60
SANDBOX_MAX_HOURS=8
# Per command, seconds: DEFAULT when the model passes no timeout (it rarely
# does), MAX caps what it may ask for. apt-get installs on the Pi easily
# pass 60 s, and big ones 300 s (swiftlang ~430 s). LibreChat waits for
# this server as long as its `timeout` in librechat.yaml (the MCP request
# and the HTTP header/body timeouts alike), so that must stay above MAX +
# 15 s.
SANDBOX_DEFAULT_TIMEOUT=300
SANDBOX_MAX_TIMEOUT=900
# Characters of command output returned to the model (head + tail).
SANDBOX_OUTPUT_LIMIT=8000

# --- Optional stronger isolation ---
# OCI runtime for the sandboxes, e.g. runsc (gVisor) once installed and
# registered in /etc/docker/daemon.json. Empty = Docker's default (runc).
SANDBOX_RUNTIME=

# --- Image pins ---
# lscr.io/linuxserver/socket-proxy (arm64 + amd64). Bump deliberately.
SOCKET_PROXY_TAG=3.4.6-r0-ls101
