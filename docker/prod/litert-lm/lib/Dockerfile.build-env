# Build environment for lib/build.sh: what upstream's linux_arm64 CI needs
# to build LiteRT-LM's C library with Bazel. clang is required (.bazelrc
# forces CC=clang on Linux); git-lfs fetches the prebuilt closed-source
# libraries under prebuilt/linux_arm64. bazelisk picks the repo's pinned
# Bazel. rules_python refuses to run as root, hence the uid 1000 user.
FROM debian:trixie
RUN apt-get update && apt-get install -y --no-install-recommends \
      clang lld llvm git git-lfs curl ca-certificates python3 python3-venv \
      zip unzip patch file xz-utils build-essential pkg-config patchelf \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL -o /usr/local/bin/bazel \
      https://github.com/bazelbuild/bazelisk/releases/download/v1.25.0/bazelisk-linux-arm64 \
    && chmod +x /usr/local/bin/bazel
RUN useradd -u 1000 -M -d /home/builder builder
