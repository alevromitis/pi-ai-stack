# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.
#
# Auto-loaded by Compose for ${...} interpolation only. It is NOT passed to
# any container - container settings live in the .env.<name> files.

# --- App ---
APP_PORT=9379
APP_CONTAINER_PORT=9379

# ---------------------------------------------------------------------------
# Which model to auto-import into the local registry and serve.
# Swap these for any model in https://huggingface.co/litert-community
# (e.g. gemma-4-E4B, qwen, phi-4, ... — check it fits in the Pi 5's RAM).
# ---------------------------------------------------------------------------
LITERT_HF_REPO=litert-community/gemma-4-E2B-it-litert-lm
LITERT_MODEL_FILE=gemma-4-E2B-it.litertlm
LITERT_MODEL_ID=gemma4-e2b

# Inference backend: "gpu" (experimental Vulkan/V3DV) or "cpu".
LITERT_BACKEND=cpu

# Context window (tokens) for prompt + response combined.
LITERT_MAX_NUM_TOKENS=32768

# Hard memory cap (only used if mem_limit is uncommented in the compose file).
#LITERT_MEM_LIMIT=7g
#LITERT_MEM_RESERVATION=4g
