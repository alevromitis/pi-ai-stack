# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.
#
# Auto-loaded by Compose for ${...} interpolation only. It is NOT passed to
# any container - container settings live in the .env.<name> files.

# --- App ---
APP_PORT=9379
APP_CONTAINER_PORT=9379

# ---------------------------------------------------------------------------
# Which model to auto-import into the local registry and serve.
# Swap these for any model in https://huggingface.co/litert-community
# (e.g. gemma-4-E4B, qwen, phi-4, ... — check it fits in the Pi 5's RAM).
# ---------------------------------------------------------------------------
LITERT_HF_REPO=litert-community/gemma-4-E2B-it-litert-lm
LITERT_MODEL_FILE=gemma-4-E2B-it.litertlm
LITERT_MODEL_ID=gemma4-e2b
# Gemma 4 E4B, off for now: stronger reasoning / tool use (Tau2 42% vs 25%)
# but ~3x slower on the Pi (2026-10-07: decode 3.2 vs 9.1 tok/s, prefill 39
# vs 148). Not yet tried at a 32k context. Switching also needs the model ids
# in ../librechat/librechat-config/librechat.yaml.
#LITERT_HF_REPO=litert-community/gemma-4-E4B-it-litert-lm
#LITERT_MODEL_FILE=gemma-4-E4B-it.litertlm
#LITERT_MODEL_ID=gemma4-e4b

# Inference backend: "gpu" (experimental Vulkan/V3DV) or "cpu".
LITERT_BACKEND=cpu

# Context window (tokens) for prompt + response combined. Half the model's
# 32768 (2026-10-08): less KV-cache memory and shorter worst-case prefills.
# LibreChat's window (librechat.yaml tokenConfig + maxContextTokens, 13312)
# must stay below it.
LITERT_MAX_NUM_TOKENS=16384

# Reuse the last conversation's KV cache so a follow-up or tool round only
# prefills its new messages (patches/prefix_cache.py). 0 = upstream behaviour.
#LITERT_PREFIX_CACHE=1

# Hard memory cap (only used if mem_limit is uncommented in the compose file).
#LITERT_MEM_LIMIT=7g
#LITERT_MEM_RESERVATION=4g
