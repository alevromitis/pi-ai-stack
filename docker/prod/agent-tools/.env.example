# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.
#
# Auto-loaded by Compose for ${...} interpolation only. Nothing here is
# secret: this stack holds no credentials at all, by design.

# Host directory every data path below hangs off. Change this one line to move the data.
DATA_ROOT=/home/<user>/docker/prod

# --- Host paths ---
# The agents' only writable host path, shared by all three servers as
# /workspace. Must exist and be owned by uid/gid 1000 before the first start:
#   mkdir -p /home/<user>/docker/prod/agent-tools/workspace/playwright
#   sudo chown -R 1000:1000 /home/<user>/docker/prod/agent-tools/workspace
AGENT_WORKSPACE_DIR=${DATA_ROOT}/agent-tools/workspace

# --- Shell server ---
# Command names (not command lines) mcp-shell-server may launch. Its default
# policy rejects interpreters (python, sh, node), env, xargs, find -exec etc.
# even if listed here, and there is no switch to allow them: this is a file
# and text tool, not a code runner. No network tools (no network anyway).
SHELL_ALLOW_COMMANDS=ls,cat,head,tail,wc,grep,find,sort,uniq,cut,tr,sed,awk,jq,diff,file,du,df,stat,date,echo,printf,mkdir,cp,mv,rm,touch,tar,gzip,gunzip,bc,basename,dirname,realpath,tee

# --- Image pins ---
# mcr.microsoft.com/playwright/mcp has no version tags. This digest is
# Playwright MCP 0.0.82 (arm64 + amd64), pulled 2026-10-06.
PLAYWRIGHT_MCP_DIGEST=sha256:77dccc5ce9e94cb8ae7ebea87ddbb6cd54b05760c4d63c54e16accf2726b8734
