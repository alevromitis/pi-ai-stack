# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.
#
# Auto-loaded by Compose for ${...} interpolation only. It is NOT passed to
# any container - container settings live in the .env.<name> files.

# Host directory every data path below hangs off. Change this one line to move the data.
DATA_ROOT=/home/<user>/docker/prod

# --- App ---
APP_PORT=8081
APP_CONTAINER_PORT=8080

# --- Host paths ---
# Holds settings.yml (incl. secret_key), owned by uid 977.
SEARXNG_CONFIG_DIR=${DATA_ROOT}/searxng/config

# --- Image tags ---
TAG=latest
VALKEY_TAG=7-alpine
