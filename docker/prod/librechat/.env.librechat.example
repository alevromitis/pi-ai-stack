# Copy this file to .env.librechat and fill in real values.
# NEVER commit the actual .env.librechat file.
#
# Read by env_file only (never interpolated), so secrets stay out of .env.
# Both librechat and meilisearch read this file - meilisearch for
# MEILI_MASTER_KEY, which both sides must agree on.

# --- Server ---
# Where users reach the UI. Wrong values break OAuth callbacks, password
# reset links and anything else that builds an absolute URL.
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080
# Ask search engines not to index the instance.
NO_INDEX=true

# --- Registration ---
# Leave true long enough to create the first account, then set it to false
# and restart - there is no admin invite flow to fall back on.
ALLOW_REGISTRATION=true
ALLOW_EMAIL_LOGIN=true
ALLOW_SOCIAL_LOGIN=false

# --- Secrets ---
# Generate with:
#   CREDS_KEY / JWT_SECRET / JWT_REFRESH_SECRET / MEILI_MASTER_KEY:
#     openssl rand -hex 32
#   CREDS_IV:
#     openssl rand -hex 16
# CREDS_KEY/CREDS_IV encrypt user-supplied API keys at rest in Mongo.
# Changing them after users have saved keys makes those keys undecryptable.
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=
# Must match on both containers; they read it from this same file.
MEILI_MASTER_KEY=

# --- LiteRT-LM provider ---
# Substituted into librechat-config/librechat.yaml as ${LITERT_LM_BASE_URL}
# and ${LITERT_LM_API_KEY}. LibreChat resolves those from the container's
# environment, which is why they are here and not in librechat.yaml directly.
#
# LiteRT-LM's `serve` command implements no authentication, but LibreChat
# drops any custom endpoint whose apiKey is empty - hence the placeholder.
LITERT_LM_BASE_URL=http://litert-lm-1:9379/v1
LITERT_LM_API_KEY=litert-lm

# --- Qwen provider (workstation/llama-qwen) ---
# ${QWEN_BASE_URL} and ${QWEN_API_KEY} in librechat.yaml: llama-server on the
# workstation, over the tailnet. The key is a line of
# ~/.config/llama-qwen/api-keys there. Generate with: openssl rand -hex 32
QWEN_BASE_URL=http://<workstation-tailnet-ip>:8091/v1
QWEN_API_KEY=
