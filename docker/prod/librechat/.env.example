# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.
#
# Auto-loaded by Compose, so this is the ONLY file whose values can be used
# for ${...} interpolation in ports:/volumes:/image:. Credentials belong in
# .env.librechat, which env_file passes straight through instead.

# Host directory every data path below hangs off. Change this one line to move the data.
DATA_ROOT=/home/<user>/docker/prod

# --- Ports ---
# Host port the LibreChat UI is published on.
APP_PORT=3080
# Port the Node process binds to INSIDE the container. The compose file feeds
# this to LibreChat's own PORT variable, so the two can never drift.
APP_CONTAINER_PORT=3080

# --- Host paths ---
# All four must exist and be owned by uid/gid 1000 before the first start:
#   sudo mkdir -p ~/docker/prod/librechat/{data/{uploads,images,logs},data-mongo,data-meili,data-vectordb}
#   sudo chown -R 1000:1000 ~/docker/prod/librechat
LIBRECHAT_DATA_DIR=${DATA_ROOT}/librechat/data
LIBRECHAT_MONGO_DATA_DIR=${DATA_ROOT}/librechat/data-mongo
LIBRECHAT_MEILI_DATA_DIR=${DATA_ROOT}/librechat/data-meili
LIBRECHAT_VECTORDB_DATA_DIR=${DATA_ROOT}/librechat/data-vectordb

# --- Provider networks ---
# The bridge network the litert-lm stack creates. LibreChat joins it to reach
# litert-lm-1:9379, rag_api to reach litert-lm-2:9379, by container DNS; that
# stack must be up first.
LITERT_NETWORK=litert-lm-external
# The internal network the agent-tools stack creates. LibreChat joins it to
# reach the shell, filesystem and playwright MCP servers; that stack must be up.
AGENT_TOOLS_NETWORK=agent-tools-internal
# The internal network the agent-connectors stack creates. LibreChat joins it
# to reach the FreshRSS and Nextcloud MCP servers; that stack must be up.
AGENT_CONNECTORS_NETWORK=agent-connectors-internal
# The internal network the agent-sandbox stack creates. LibreChat joins it
# to reach the sandbox gateway; that stack must be up.
AGENT_SANDBOX_NETWORK=agent-sandbox-internal

# --- Image tags ---
# Pinned, unlike the rest of this repo. Digests for each are in comments next
# to the `image:` lines in the compose file if you want to pin harder still.
# LibreChat config-file schema is tied to the app version: v0.8.7 expects
# librechat.yaml `version: 1.3.13`. Bump both together.
TAG=v0.8.7
MONGO_TAG=8.0.20
MEILI_TAG=v1.35.1
RAG_API_TAG=v0.9.0
PGVECTOR_TAG=0.8.0-pg15-trixie

TZ=UTC
