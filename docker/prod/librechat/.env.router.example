# Copy this file to .env.router and fill in real values.
# NEVER commit the actual .env.router file.
#
# Read by env_file by librechat-router-1 only (LibreChat's Qwen endpoint).

# The key llama-server on the workstation accepts: the line in
# ~/.config/llama-qwen/api-keys there (workstation/llama-qwen). Generate with:
#   openssl rand -hex 32
PRIMARY_API_KEY=
